# --- App ---
NODE_ENV=development
PORT=3000

# --- Postgres (dedicated schema/db for K-APEX-08 on the shared instance) ---
DATABASE_URL="postgresql://kapex08:changeme@postgres-shared:5432/kapex08?schema=public"

# --- Redis (shared instance, isolated by DB index) ---
REDIS_HOST=redis-shared
REDIS_PORT=6379
REDIS_DB=8
REDIS_KEY_PREFIX="kapex08:"

# --- K-ID / JWT ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=14
TOTP_ISSUER="Kobata Matrix Corporation"

# --- WebAuthn ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="K-APEX-08"
WEBAUTHN_ORIGIN=http://localhost:3001

# --- AI enrichment (optional, never on critical path) ---
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.anthropic.com
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# --- K-DIRECTIVE / dead man's switch ---
OPERATOR_HEARTBEAT_TIMEOUT_MS=120000
