# Cópia pra uso com docker-compose.local.yml — copie pra .env quando for
# rodar localmente contra os containers locais (não a VPS).

NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://kapex08:changeme@localhost:5433/kapex08?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_KEY_PREFIX="kapex08:"

JWT_ACCESS_SECRET=dev_only_secret_change_before_any_real_deploy
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=14
TOTP_ISSUER="Kobata Matrix Corporation (dev)"

WEBAUTHN_RP_ID=localhost
